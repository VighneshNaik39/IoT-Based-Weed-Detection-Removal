# Copy this file to .env and set values for your local network.
PORT=5000

# Must match HOSTNAME in the robot firmware (without .local).
ESP32_HOSTNAME=weedguard-robot
# Optional fallback if Windows/network mDNS does not resolve the robot. Example: 192.168.1.50
ESP32_IP=
# Must exactly match API_KEY in ESP32_WeedRobot_v10_mdns.ino
ESP32_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_KEY

# Camera hostname must match WiFi.setHostname() in the camera firmware.
CAMERA_HOSTNAME=weedguard-cam
# Optional fallback stream URL if mDNS is blocked. Example: http://192.168.1.51:81/stream
CAMERA_STREAM_URL=

# Keep false while testing. Set true only after safe cutter testing.
ENABLE_AUTOMATIC_CUTTING=false
